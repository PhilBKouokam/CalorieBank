NODE_ENV=development
# Local may use the explicit development identity shortcut. For physical Clerk QA,
# set AUTH_MODE=clerk and configure both Clerk keys; never mix Clerk mobile auth
# with an API running AUTH_MODE=development.
APP_ENV=local
AUTH_MODE=development
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
PORT=3000
CORS_ORIGIN=*
DATABASE_URL=postgresql://caloriebank:caloriebank@localhost:5432/caloriebank
SHADOW_DATABASE_URL=postgresql://caloriebank:caloriebank@localhost:5432/caloriebank_shadow
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_USER_EMAIL=developer@caloriebank.local
TODAY_INGESTION_MODE=device
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=https://your-development-api.example/v1/me/integrations/fitbit/callback
# Base64-encoded 32-byte key. Generate locally with: openssl rand -base64 32
GOOGLE_HEALTH_TOKEN_ENCRYPTION_KEY=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://your-development-api.example/v1/me/integrations/whoop/callback
# Base64-encoded 32-byte key. Generate locally with: openssl rand -base64 32
WHOOP_TOKEN_ENCRYPTION_KEY=
# Shared by server-side OAuth providers such as FatSecret. Generate with: openssl rand -base64 32
EXTERNAL_PROVIDER_TOKEN_ENCRYPTION_KEY=
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
FATSECRET_REDIRECT_URI=https://your-development-api.example/v1/me/integrations/fatsecret/callback
# Render private beta runs `npm run lifecycle:run` hourly as a separate cron process.
# It uses the same server-only variables above and never uses DEV_USER_ID.

{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "CALORIEBANK_IOS_ALLOW_LOCAL_HTTP": "1",
        "EXPO_PUBLIC_HEALTH_CONNECT_QUALIFICATION": "1"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "beta",
        "EXPO_PUBLIC_AUTH_MODE": "clerk",
        "EXPO_PUBLIC_HEALTH_CONNECT_QUALIFICATION": "1"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "testflight": {
      "extends": "preview",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_HEALTH_CONNECT_QUALIFICATION": "0"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_HEALTH_CONNECT_QUALIFICATION": "0"
      }
    },
    "play-testing": {
      "extends": "preview",
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_HEALTH_CONNECT_QUALIFICATION": "0"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
